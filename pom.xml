<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Memes versions que le reste du cours (Spring_MongoDB_VsSQL). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>fr.formation</groupId>
    <artifactId>connexion-complete</artifactId>
    <version>1.0.0</version>
    <name>connexion-complete</name>
    <description>Les trois corrections de « Optimisation d'une collection », portees en Spring Data MongoDB</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
    </dependencies>

    <!--
        UN module, TROIS applications. Chacune a son point d'entree, son
        port et sa base ; elles partagent fr.formation.connexion.commun,
        le banc de mesure. Le plugin Spring Boot produit donc trois jars
        executables, un par classifier :

            target/connexion-complete-1.0.0-dune.jar
            target/connexion-complete-1.0.0-tortues.jar
            target/connexion-complete-1.0.0-bateaux.jar

        L'execution « repackage » heritee du parent est desactivee : avec
        trois classes main, elle ne saurait pas laquelle prendre.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <configuration><skip>true</skip></configuration>
                    </execution>
                    <execution>
                        <id>jar-dune</id>
                        <goals><goal>repackage</goal></goals>
                        <configuration>
                            <classifier>dune</classifier>
                            <mainClass>fr.formation.connexion.dune.DuneApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-tortues</id>
                        <goals><goal>repackage</goal></goals>
                        <configuration>
                            <classifier>tortues</classifier>
                            <mainClass>fr.formation.connexion.tortues.TortuesApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-bateaux</id>
                        <goals><goal>repackage</goal></goals>
                        <configuration>
                            <classifier>bateaux</classifier>
                            <mainClass>fr.formation.connexion.bateaux.BateauxApplication</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
